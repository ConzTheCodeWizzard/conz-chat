<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bgMain">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@color/bgTopBar">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:padding="8dp"
            android:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Settings"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ===== ACCOUNT SECTION ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤 Account"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnChangeDisplayName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="✏️ Change Display Name"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="8dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp" />

            <Button
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🔑 Change Password"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="24dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp" />

            <!-- ===== BRIGHTNESS SECTION ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀️ Brightness"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <SeekBar
                    android:id="@+id/seekBrightness"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="#FF0033"
                    android:thumbTint="#FF0033" />

                <TextView
                    android:id="@+id/tvBrightnessValue"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:gravity="end"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- ===== CONZMODS SECTION ===== -->
            <LinearLayout
                android:id="@+id/layoutConzMods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ ConzMods"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <!-- Disable Read Receipts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Disable Read Receipts"
                        android:textSize="15sp"
                        android:textColor="#CCCCCC" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Others won't see you've read their messages"
                        android:textSize="12sp"
                        android:textColor="#666666" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDisableReceipts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#FF0033"
                    android:trackTint="#440011" />
            </LinearLayout>

            <!-- Disable Typing Indicator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Disable Typing Indicator"
                        android:textSize="15sp"
                        android:textColor="#CCCCCC" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Other people will not see you typing"
                        android:textSize="12sp"
                        android:textColor="#666666" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDisableTyping"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#FF0033"
                    android:trackTint="#440011" />
            </LinearLayout>

            <!-- Fake Camera Label -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fake Camera Label on Photos"
                        android:textSize="15sp"
                        android:textColor="#CCCCCC" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Photos show as taken with camera"
                        android:textSize="12sp"
                        android:textColor="#666666" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchFakeCamera"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#FF0033"
                    android:trackTint="#440011" />
            </LinearLayout>

            <!-- Screenshot Protection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Screenshot Protection"
                        android:textSize="15sp"
                        android:textColor="#CCCCCC" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prevent screenshots in chats"
                        android:textSize="12sp"
                        android:textColor="#666666" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchScreenshotProtection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#FF0033"
                    android:trackTint="#440011" />
            </LinearLayout>

            </LinearLayout>
            <!-- ===== OTHER BUTTONS ===== -->
            <Button
                android:id="@+id/btnCredits"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="⭐ Credits"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_red"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnDevMenu"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🔧 Dev Menu"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_red"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🚪 Logout"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_red"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnDeleteAccount"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Delete Account"
                android:textColor="#888888"
                android:background="@android:color/transparent" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
