<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ConzChat" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/textPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/textPrimary</item>
        <item name="android:colorBackground">@color/bgMain</item>
        <item name="android:windowBackground">@color/bgMain</item>
        <item name="android:statusBarColor">@color/bgMain</item>
        <item name="android:navigationBarColor">@color/bgMain</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
    </style>

    <!-- Light Mode Theme -->
    <style name="Theme.ConzChat.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/lightBg</item>
        <item name="android:windowBackground">@color/lightBg</item>
        <item name="android:statusBarColor">@color/lightBg</item>
        <item name="android:navigationBarColor">@color/lightBg</item>
        <item name="android:textColorPrimary">@color/lightTextPrimary</item>
        <item name="android:textColorSecondary">@color/lightTextSecondary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Harley Quinn Theme -->
    <style name="Theme.ConzChat.HarleyQuinn" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/hqPrimary</item>
        <item name="colorPrimaryVariant">@color/hqPrimaryDark</item>
        <item name="colorOnPrimary">@color/hqTextPrimary</item>
        <item name="colorSecondary">@color/hqAccent</item>
        <item name="colorOnSecondary">@color/hqTextPrimary</item>
        <item name="android:colorBackground">@color/hqBg</item>
        <item name="android:windowBackground">@color/hqBg</item>
        <item name="android:statusBarColor">@color/hqTopBar</item>
        <item name="android:navigationBarColor">@color/hqBg</item>
        <item name="android:textColorPrimary">@color/hqTextPrimary</item>
        <item name="android:textColorSecondary">@color/hqTextSecondary</item>
    </style>

    <style name="Theme.ConzChat.Splash" parent="Theme.ConzChat">
        <item name="android:windowBackground">@color/bgMain</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.ConzChat.Call" parent="Theme.ConzChat">
        <item name="android:windowBackground">@color/bgMain</item>
    </style>

    <!-- Button styles -->
    <style name="Widget.ConzChat.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.ConzChat.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- EditText style -->
    <style name="Widget.ConzChat.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="hintTextColor">@color/textSecondary</item>
        <item name="android:textColorHint">@color/textHint</item>
    </style>
</resources>
