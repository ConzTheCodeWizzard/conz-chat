<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Top bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bgTopBar">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_back"
            android:padding="8dp"
            android:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="🔧 Dev Inbox"
            android:textColor="@color/colorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_tab_button"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 Stats"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="10dp" />

                <TextView android:id="@+id/tvUserCount"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="👥 Loading..." android:textColor="#CCCCCC" android:textSize="13sp"
                    android:layout_marginBottom="4dp" />
                <TextView android:id="@+id/tvMessageCount"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="💬 Loading..." android:textColor="#CCCCCC" android:textSize="13sp"
                    android:layout_marginBottom="4dp" />
                <TextView android:id="@+id/tvGroupCount"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="👥 Loading..." android:textColor="#CCCCCC" android:textSize="13sp"
                    android:layout_marginBottom="4dp" />
                <TextView android:id="@+id/tvPublicGroupCount"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🌐 Loading..." android:textColor="#CCCCCC" android:textSize="13sp" />
            </LinearLayout>

            <!-- Broadcast -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_tab_button"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📬 Broadcast Message"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sends a DM from you to every user"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/etBroadcast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Message to broadcast..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#555555"
                    android:background="@drawable/bg_input"
                    android:padding="10dp"
                    android:minLines="2"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvBroadcastStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnBroadcast"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="📬  Send Broadcast"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_tab_button" />
            </LinearLayout>

            <!-- Announcement -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_tab_button"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📢 App Announcement"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shows a popup to all users on next app open"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/etAnnouncement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Announcement text (leave empty to clear)..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#555555"
                    android:background="@drawable/bg_input"
                    android:padding="10dp"
                    android:minLines="2"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/btnSetAnnouncement"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="📢  Set Announcement"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_tab_button" />
            </LinearLayout>

            <!-- Premium management -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_tab_button"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💎 Premium Management"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/etPremiumUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@username"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#555555"
                    android:background="@drawable/bg_input"
                    android:padding="10dp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnGivePremium"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="✅ Give"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_tab_button"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/btnRevokePremium"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="❌ Revoke"
                        android:textSize="14sp"
                        android:textColor="#FF6666"
                        android:background="@drawable/bg_tab_button" />
                </LinearLayout>
            </LinearLayout>

            <!-- Boot / Ban user -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_tab_button"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚫 Boot / Ban User"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/etBootUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@username"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#555555"
                    android:background="@drawable/bg_input"
                    android:padding="10dp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etBootReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Reason (optional)"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#555555"
                    android:background="@drawable/bg_input"
                    android:padding="10dp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnBoot"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="🥾 Boot"
                        android:textSize="14sp"
                        android:textColor="#FFAA00"
                        android:background="@drawable/bg_tab_button"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/btnBan"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="⛔ Ban"
                        android:textSize="14sp"
                        android:textColor="#FF4444"
                        android:background="@drawable/bg_tab_button" />
                </LinearLayout>
            </LinearLayout>

            <!-- Push version update -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_tab_button"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔄 Push App Update"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Users will see update prompt on Check for Updates"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/etNewVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="New version (e.g. 1.8)"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#555555"
                    android:background="@drawable/bg_input"
                    android:padding="10dp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etApkUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="APK download URL"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#555555"
                    android:background="@drawable/bg_input"
                    android:padding="10dp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/btnPushVersion"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="🔄  Push Update"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_tab_button" />
            </LinearLayout>

            <!-- Account Collector -->
            <TextView
                android:id="@+id/btnAccountCollector"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="\uD83D\uDCCB  ACCOUNT COLLECTOR"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/bg_tab_button"
                android:layout_marginTop="16dp" />

            <!-- ConzFeed -->
            <TextView
                android:id="@+id/btnConzFeed"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="\uD83D\uDCF0  CONZFEED"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/bg_tab_button"
                android:layout_marginTop="12dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
