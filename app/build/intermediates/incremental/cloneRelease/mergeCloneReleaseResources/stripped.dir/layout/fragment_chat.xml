<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgMain">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@color/bgTopBar"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:padding="8dp"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/ivChatAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_default_avatar"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_avatar"
            android:clipToOutline="true"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvChatName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvTopbarBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="11sp"
                    android:textColor="#FFD700"
                    android:visibility="gone" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvChatStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#888888"
                android:visibility="gone" />

        </LinearLayout>

        <ImageView
            android:id="@+id/ivChatSearch"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_search"
            android:padding="6dp"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/ivVoiceCall"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_call"
            android:padding="6dp"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/ivVideoCall"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_videocam"
            android:padding="6dp"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Messages list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@id/bottomArea"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        android:clipToPadding="false" />

    <!-- Bottom area -->
    <LinearLayout
        android:id="@+id/bottomArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:background="@color/bgChatBar">

        <!-- Typing indicator moved to topbar (tvChatStatus) -->

        <!-- Reply bar -->
        <LinearLayout
            android:id="@+id/replyBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_reply_bar"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="#FF0033"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReplySender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#FF0033"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReplyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#AAAAAA"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnCancelReply"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_close"
                android:tint="#888888" />
        </LinearLayout>

        <!-- Media bar -->
        <LinearLayout
            android:id="@+id/mediaBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:background="@color/bgCard"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btnCamera"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_camera"
                android:padding="8dp"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/btnGallery"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_image"
                android:padding="8dp"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/btnVideo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_videocam"
                android:padding="8dp"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/btnVoice"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_mic"
                android:padding="8dp"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/btnGif"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_gif"
                android:padding="8dp"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/btnViewOnce"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_fire"
                android:padding="8dp"
                android:tint="#FF6600"
                android:alpha="0.5" />

        </LinearLayout>

        <!-- Input bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/btnMedia"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_add"
                android:padding="6dp"
                android:tint="#FF0033" />

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="@string/hint_message"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="16dp"
                android:textSize="15sp"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:layout_marginHorizontal="8dp" />

            <ImageView
                android:id="@+id/btnSend"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_send"
                android:padding="6dp"
                android:tint="#FF0033"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

    <!-- Conz Super Menu overlay -->
    <LinearLayout
        android:id="@+id/conzMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bgCard"
        android:padding="16dp"
        android:layout_above="@id/bottomArea"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Conz Super Menu"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FF0033"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnPremiumMenu"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="💎 Premium Menu"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_red"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnBootUser"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="👢 Boot User"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_red"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnBanUser"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="🚫 Ban User"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_red"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnConzMenuClose"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Close"
            android:textColor="#AAAAAA"
            android:background="@android:color/transparent" />
    </LinearLayout>

    <!-- Premium Menu overlay -->
    <LinearLayout
        android:id="@+id/premiumMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bgCard"
        android:padding="16dp"
        android:layout_above="@id/bottomArea"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💎 Premium Menu"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etAnimatedMsg"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Animated message text..."
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnStartSpam"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="▶ Start"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_red"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnStopSpam"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="⏹ Stop"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_red"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGivePremium"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="💎 Give Premium to this user"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_red"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvPremiumConsole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnClosePremiumMenu"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="← Back"
            android:textColor="#AAAAAA"
            android:background="@android:color/transparent" />
    </LinearLayout>

</RelativeLayout>
