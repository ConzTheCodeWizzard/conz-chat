<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgMain">

    <!-- Deep gradient background overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_welcome_gradient" />

    <!-- Decorative red glow circle top-right -->
    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-80dp"
        android:background="@drawable/bg_glow_circle" />

    <!-- Decorative red glow circle bottom-left -->
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-60dp"
        android:layout_marginStart="-60dp"
        android:background="@drawable/bg_glow_circle_small" />

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="80dp"
        android:paddingBottom="48dp">

        <!-- Logo area -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ConzChat"
            android:textSize="52sp"
            android:textStyle="bold"
            android:textColor="#FF0033"
            android:letterSpacing="0.02"
            android:layout_marginBottom="12dp" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Made with love by Conz ❤️"
            android:textSize="15sp"
            android:textColor="#AAAAAA"
            android:letterSpacing="0.03"
            android:layout_marginBottom="40dp" />

        <!-- Feature pills row 1 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 Conz AI"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_feature_pill"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📸 Stories"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_feature_pill"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎭 ConzMods"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_feature_pill"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp" />

        </LinearLayout>

        <!-- Feature pills row 2 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="56dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📞 Voice &amp; Video"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_feature_pill"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥 Groups"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_feature_pill"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎞️ GIFs"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_feature_pill"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp" />

        </LinearLayout>

        <!-- Spacer -->
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <!-- Saved Accounts Button -->
        <Button
            android:id="@+id/btnSavedAccounts"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="🔒 Saved Accounts"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#AAAAAA"
            android:background="@android:color/transparent"
            android:layout_marginBottom="16dp"
            android:stateListAnimator="@null" />

        <!-- Rotating tagline -->
        <TextView
            android:id="@+id/tvRotating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Built by ~Conz~"
            android:textSize="13sp"
            android:textColor="#FF0033"
            android:gravity="center"
            android:layout_marginBottom="32dp"
            android:alpha="0.8" />

        <!-- Login Button -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Sign In"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_login"
            android:layout_marginBottom="14dp"
            android:stateListAnimator="@null" />

        <!-- Register Button -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Create Account"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FF0033"
            android:background="@drawable/bg_btn_register"
            android:layout_marginBottom="28dp"
            android:stateListAnimator="@null" />

        <!-- Version -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v4.0.0"
            android:textSize="12sp"
            android:textColor="#333333" />

    </LinearLayout>

</FrameLayout>
