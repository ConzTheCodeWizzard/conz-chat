<?xml version="1.0" encoding="utf-8"?>
<!--
  Chat message row.
  Alignment is controlled entirely in the adapter via layout_gravity on llBubbleOuter:
    - "me"   messages: layout_gravity="end"   → red bubble pushed to RIGHT
    - "them" messages: layout_gravity="start" → dark bubble stays on LEFT

  The outer llWrap is a vertical LinearLayout (full-width).
  Inside it:
    1. llRow  — horizontal row: [avatar] [bubble] [receipt]
    2. tvMeta — timestamp below bubble, hidden by default, toggled on tap
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llWrap"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="2dp"
    android:paddingHorizontal="8dp">

    <!-- Row: avatar + bubble + receipt tick -->
    <LinearLayout
        android:id="@+id/llRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom">

        <!-- Avatar (shown for "them", gone for "me") -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_default_avatar"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <!-- Spacer pushed to left for "me" messages (fills space where avatar would be) -->
        <View
            android:id="@+id/spacerStart"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <!-- WhatsApp tick receipt — LEFT of bubble for "me" messages -->
        <TextView
            android:id="@+id/tvReceipt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:layout_gravity="bottom"
            android:visibility="gone" />

        <!-- Bubble -->
        <LinearLayout
            android:id="@+id/llBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_bubble_them">

            <!-- Reply preview -->
            <TextView
                android:id="@+id/tvReplyPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#AAAAAA"
                android:background="@drawable/bg_reply_bar"
                android:padding="6dp"
                android:layout_marginBottom="4dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone" />

            <!-- Camera label -->
            <TextView
                android:id="@+id/tvCameraLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 Camera"
                android:textSize="11sp"
                android:textColor="#888888"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />

            <!-- Text message -->
            <TextView
                android:id="@+id/tvText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:lineSpacingExtra="2dp"
                android:visibility="gone" />

            <!-- Image -->
            <ImageView
                android:id="@+id/ivImage"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- Video -->
            <VideoView
                android:id="@+id/videoView"
                android:layout_width="200dp"
                android:layout_height="150dp"
                android:visibility="gone" />

            <!-- Voice note -->
            <LinearLayout
                android:id="@+id/llVoice"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvVoiceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎤 Voice Note"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:paddingVertical="8dp" />

                <TextView
                    android:id="@+id/tvTranscript"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#AAAAAA"
                    android:fontFamily="serif"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- View-once -->
            <TextView
                android:id="@+id/tvViewOnce"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#FF6600"
                android:paddingVertical="8dp"
                android:visibility="gone" />

            <!-- Reactions row -->
            <LinearLayout
                android:id="@+id/llReactions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Spacer pushed to right for "them" messages -->
        <View
            android:id="@+id/spacerEnd"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Timestamp: below bubble, hidden by default, toggled on tap -->
    <TextView
        android:id="@+id/tvMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#666666"
        android:layout_marginTop="2dp"
        android:visibility="gone" />

</LinearLayout>
