<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Top bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bgTopBar">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_back"
            android:padding="8dp"
            android:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Profile"
            android:textColor="@color/colorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Cover + avatar overlap: FrameLayout where cover is 180dp,
                 avatar (96dp) sits centered at the bottom edge of the cover,
                 so marginTop = 180 - 48 = 132dp (half of 96dp = 48dp) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="228dp">

                <!-- Cover photo - clickable, fills top 180dp -->
                <ImageView
                    android:id="@+id/ivCover"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_gravity="top"
                    android:scaleType="centerCrop"
                    android:background="#1A1A1A"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Invisible btnEditCover (kept for code compat, just not shown) -->
                <View
                    android:id="@+id/btnEditCover"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- Avatar: centered horizontally, straddles cover bottom edge -->
                <!-- marginTop = 180 - 48 = 132dp -->
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="132dp"
                    app:civ_border_width="3dp"
                    app:civ_border_color="@color/colorPrimary"
                    android:src="@drawable/ic_default_avatar"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Invisible btnChangeAvatar (kept for code compat) -->
                <View
                    android:id="@+id/btnChangeAvatar"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- Profile info, centered, below the avatar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp">

                <!-- Dev badge -->
                <TextView
                    android:id="@+id/tvDevBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👑 ConzChat Dev"
                    android:textSize="13sp"
                    android:textColor="#FFD700"
                    android:textStyle="bold"
                    android:background="#33FFD700"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:layout_marginTop="6dp"
                    android:visibility="gone" />

                <!-- Premium badge -->
                <TextView
                    android:id="@+id/tvPremiumBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💎 Premium User"
                    android:textSize="13sp"
                    android:textColor="#00CFFF"
                    android:textStyle="bold"
                    android:background="#2200CFFF"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:layout_marginTop="6dp"
                    android:visibility="gone" />

                <!-- Display name -->
                <TextView
                    android:id="@+id/tvDisplayName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="10dp" />

                <!-- Username -->
                <TextView
                    android:id="@+id/tvUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#888888"
                    android:layout_marginTop="2dp" />

                <!-- Status -->
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#CCCCCC"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:layout_marginTop="6dp"
                    android:visibility="gone" />

                <!-- Edit status (own profile) -->
                <TextView
                    android:id="@+id/tvStatusEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✏️ Edit status"
                    android:textSize="13sp"
                    android:textColor="@color/colorPrimary"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />

                <!-- Friend count -->
                <TextView
                    android:id="@+id/tvFriendCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#888888"
                    android:layout_marginTop="8dp" />

                <!-- Days on ConzChat -->
                <TextView
                    android:id="@+id/tvDaysOnApp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#555555"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:background="#1AFFFFFF" />

            <!-- OWN PROFILE: centered vertical tab buttons (NO Edit Profile) -->
            <LinearLayout
                android:id="@+id/layoutOwnActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="40dp"
                android:paddingTop="16dp"
                android:paddingBottom="28dp"
                android:visibility="gone">

                <!-- Invisible btnEdit kept for code compat -->
                <View
                    android:id="@+id/btnEdit"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnAccountSettings"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="⚙️  Account Settings"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_tab_button"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/btnMods"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="⚡  ConzMods"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_tab_button"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/btnCredits"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="⭐  Credits"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_tab_button"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/btnCheckUpdates"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="🔄  Check for Updates"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_tab_button" />

            </LinearLayout>

            <!-- OTHER USER: centered vertical tab buttons -->
            <LinearLayout
                android:id="@+id/layoutOtherActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="40dp"
                android:paddingTop="16dp"
                android:paddingBottom="28dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnMessage"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="💬  Send Message"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_tab_button"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/btnAddFriend"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="➕  Add Friend"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_tab_button"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/btnBlock"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="🚫  Block User"
                    android:textSize="15sp"
                    android:textColor="#FF4444"
                    android:background="@drawable/bg_tab_button" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
